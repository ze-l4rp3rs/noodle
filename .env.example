# Copy to .env and fill in. .env is git-ignored. Only variables actually read are listed.

# Graph (optional; overrides graph.url in noodle.yaml)
FALKORDB_URL=localhost:6379

# Environment: dev | prod. In prod the X-Noodle-User dev header is disabled.
NOODLE_ENV=dev

# Alternative config file (optional)
# NOODLE_CONFIG=./noodle.yaml

# Provider keys (set at least one once providers are wired up)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Live ingestion is off unless this is set.
# INGEST_TOKEN=
