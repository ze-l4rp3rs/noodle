# Secrets and local environment — never commit
.env
*.env
!.env.example
*.pem
*.key
secrets/
!secrets/.gitkeep

# Run logs (may contain question text; hidden content is redacted but never commit)
runs/*
!runs/.gitkeep
*.run.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Test and tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
